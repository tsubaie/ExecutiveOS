# Required database password. Use a long random URL-safe value; Compose rejects an empty value.
POSTGRES_PASSWORD=
# Required connection URL in the application. Keep the password identical to POSTGRES_PASSWORD.
DATABASE_URL=postgresql://executiveos:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/executiveos
# Required random session secret, at least 32 characters. Never commit the populated .env.
SESSION_SECRET=
# Canonical browser origin. Production refuses to start unless this is https, except on loopback;
# the session cookie's Secure flag follows it. Use an HTTPS reverse proxy in production.
APP_URL=http://localhost:3000
# Comma-separated proxy addresses or CIDRs, for example "10.0.0.0/8, fd00::/8". Startup refuses a
# malformed list. Empty means forwarded client-address headers are untrusted, which disables
# per-address login and recovery throttling; per-email login throttling still applies.
TRUSTED_PROXY_CIDRS=
# Optional BYOK credential. Empty disables AI; no model capabilities are enabled in WI-0001.
ANTHROPIC_API_KEY=
# Container paths backed by named volumes.
FILES_DIR=/var/lib/executiveos/files
BACKUP_DIR=/var/lib/executiveos/backups
# Storage quota in GiB and maximum upload size in MiB.
FILES_QUOTA_GB=20
MAX_UPLOAD_MB=20
# PostgreSQL pool size for the application (2–64).
DB_POOL_MAX=12
# In-process runner configuration.
JOBS_ENABLED=true
JOBS_CONCURRENCY=4
JOBS_DRAIN_SECONDS=25
# Optional single-use administrator recovery token, at least 32 characters when set; startup
# refuses a shorter one. Generate with: openssl rand -hex 32. Set it, restart, use it, then unset.
RECOVERY_TOKEN=
# Structured logging level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
# Development/test only: separate disposable PostgreSQL database, never the live database.
DATABASE_URL_TEST=
