# Copy to .env.test (ignored). Loaded by `pnpm test` through node --env-file-if-exists.
# Both URLs must point at the disposable database server from docker-compose.test.yml.
NODE_ENV=test
DATABASE_URL=postgresql://executiveos:executiveos@localhost:5433/executiveos_test
DATABASE_URL_TEST=postgresql://executiveos:executiveos@localhost:5433/executiveos_test
SESSION_SECRET=local-test-only-secret-that-is-at-least-32-chars
APP_URL=http://localhost:3000
FILES_DIR=./tmp/test-files
BACKUP_DIR=./tmp/test-backups
# Single-use administrator recovery token; ADMIN-B22 requires at least 32 characters.
RECOVERY_TOKEN=test-only-recovery-token-0123456789abcdef
